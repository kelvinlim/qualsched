{
  "name": "qualsched",
  "version": "0.2.1",
  "private": true,
  "description": "QualSched monorepo: shared Svelte UI, Tauri desktop app, and QualSched Web",
  "workspaces": [
    "ui",
    "desktop",
    "web/frontend"
  ],
  "scripts": {
    "dev": "npm run tauri --workspace desktop -- dev",
    "dev:desktop": "npm run tauri --workspace desktop -- dev",
    "dev:web": "npm run dev --workspace qualsched-web",
    "build": "npm run build --workspace desktop",
    "check": "npm run check --workspaces --if-present",
    "tauri": "npm run tauri --workspace desktop --"
  },
  "license": "MIT"
}
